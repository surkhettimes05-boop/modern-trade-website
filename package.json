{
  "name": "storesync-qa",
  "private": true,
  "scripts": {
    "security:static": "node scripts/security-static-check.mjs",
    "qa:up": "node scripts/qa-compose.mjs up -d --build",
    "qa:down": "node scripts/qa-compose.mjs down --remove-orphans",
    "qa:reset": "node scripts/qa-reset.mjs",
    "qa:restart": "node scripts/qa-compose.mjs restart && npm run qa:verify",
    "qa:status": "node scripts/qa-compose.mjs ps",
    "qa:logs": "node scripts/qa-compose.mjs logs --tail=200",
    "qa:verify": "node scripts/qa-verify.mjs",
    "qa:dependency-failure": "node scripts/qa-dependency-failure.mjs",
    "qa:full-stack": "node scripts/qa-full-stack.mjs",
    "qa:certify": "npm run qa:reset && npm run qa:verify && npm run qa:restart && npm run qa:dependency-failure",
    "qa:release": "node scripts/qa-release.mjs",
    "qa:local": "node scripts/qa-local.mjs"
  }
}
