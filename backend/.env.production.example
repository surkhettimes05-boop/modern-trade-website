# Safe fixed Nepal launch configuration
ACTIVE_MARKET=NP
DEFAULT_COUNTRY_CODE=NP
DEFAULT_CURRENCY_CODE=NPR
DEFAULT_LOCALE=en-NP
DEFAULT_TIMEZONE=Asia/Kathmandu
DEFAULT_TAX_REGIME=IRD

# Runtime
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
ENABLE_ADMIN_API=true
TRUST_PROXY_HOPS=1
CORS_ORIGIN=https://your-project.vercel.app
APP_URL=https://your-project.vercel.app
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_CONNECTION_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
SHUTDOWN_TIMEOUT_MS=25000

# Managed data services
DATABASE_URL=postgresql://storesync_app:password@host:5432/storesync?sslmode=require
DATABASE_RUNTIME_ROLE=storesync_app
DATABASE_MIGRATION_ROLE=storesync_migrator
DATABASE_SSL=true
# Equivalent to sslmode=require when the managed provider CA is unavailable:
# transport remains encrypted without requiring provider certificate pinning.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
REQUIRE_LEAST_PRIVILEGE_DATABASE_ROLE=true
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=17000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_MS=750
REDIS_URL=rediss://default:password@redis-host:6379
REDIS_NAMESPACE=storesync-production
REDIS_ALLOW_PLAINTEXT_PRIVATE=false

# Optional vendor-neutral telemetry export. Point this at a private Collector;
# never include credentials in this URL. Use standard OTEL_EXPORTER_OTLP_HEADERS
# from the secret manager if the collector requires authentication.
OTEL_SERVICE_NAME=storesync-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=30000
RELEASE_VERSION=replace-with-immutable-release-id

# Required secrets: generate unique values; never reuse these placeholders.
JWT_SECRET=generate-a-long-random-value
COOKIE_SECRET=generate-a-different-long-random-value
JWT_ISSUER=storesync-backend
JWT_AUDIENCE=storesync-operations
ENCRYPTION_KEY=generate-at-least-32-random-bytes
SIGNATURE_SECRET=generate-at-least-32-random-bytes
OTP_HASH_SECRET=generate-a-different-32-byte-random-value
PAYMENT_ENCRYPTION_KEY=64-lowercase-hex-characters

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Customer OTP delivery with Twilio Verify (Twilio manages the sender).
SMS_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Static demo OTPs are forbidden in production. Use a separate non-production
# environment if the restricted demo provider is needed for testing.

# Optional email notifications; configure both or neither.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# Optional map integration; leave unset to disable.
DEFAULT_MAP_PROVIDER=
BAATO_API_KEY=
BAATO_BASE_URL=https://api.baato.com/api/v1
GALLI_API_KEY=
GALLI_BASE_URL=https://api.galli.com/api/v1

# Optional payment integrations. Keep electronic payments disabled until certified.
ENABLE_ELECTRONIC_PAYMENTS=false
ENABLE_LOYALTY=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_EXTERNAL_TAX_INTEGRATION=false
ENABLE_RETURNS=false
ENABLE_PROMOTION_ENGINE=false
ENABLE_CUSTOMER_SEGMENTS=false
ENABLE_OFFLINE_SYNC=false
ENABLE_HARDWARE_DEVICES=false
ENABLE_EXTERNAL_CMS_CDN=false
ENABLE_FISCAL_COMPLIANCE_INTEGRATION=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_API_URL=https://uat.esewa.com.np
ESEWA_SUCCESS_URL=https://your-project.vercel.app/payment/success
ESEWA_FAILURE_URL=https://your-project.vercel.app/payment/failure
KHALTI_API_KEY=
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_API_URL=https://khalti.com/api/v2
KHALTI_RETURN_URL=https://your-project.vercel.app/payment/return
KHALTI_WEBSITE_URL=https://your-project.vercel.app
FONEPAY_MERCHANT_ID=
FONEPAY_SECRET_KEY=
FONEPAY_BASE_URL=https://clientapi.fonepay.com/api

# Optional integrations
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
STRAPI_API_URL=
STRAPI_API_TOKEN=

# One-time bootstrap only; remove or rotate after creating the admin account.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-and-remove-after-use
