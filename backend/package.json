{
  "name": "backend",
  "version": "1.0.0",
  "description": "StoreSync Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "jest --config jest.unit.config.js --runInBand --detectOpenHandles --verbose",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --coverage",
    "lint": "eslint src --ext .ts",
    "lint:ci": "eslint src --ext .ts --max-warnings 500",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "migrate": "node dist/database/migrate.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "deploy:migrate": "node dist/database/deployMigrate.js",
    "verify:database-role": "node dist/database/verifyDatabaseRole.js",
    "security:verify-db-role": "tsx src/database/verifyDatabaseRole.ts",
    "seed": "tsx src/database/seed.ts",
    "bootstrap-admin": "tsx src/database/bootstrapAdmin.ts",
    "worker:types": "wrangler types src/worker-configuration.d.ts --strict-vars false",
    "worker:dev": "wrangler dev",
    "worker:type-check": "tsc --project tsconfig.worker.json --noEmit",
    "worker:check": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "node scripts/validate-worker-config.mjs && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
