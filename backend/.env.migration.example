# Supply this configuration only to the one-time migration/release job. Never
# attach MIGRATION_DATABASE_URL to the long-running backend runtime service.
NODE_ENV=production
MIGRATION_DATABASE_URL=postgresql://storesync_migrator:password@host:5432/storesync?sslmode=require
DATABASE_MIGRATION_ROLE=storesync_migrator
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Store backups on durable encrypted storage and test restoration regularly.
DATABASE_BACKUP_DIR=/var/backups/storesync
PG_DUMP_BIN=pg_dump
