NODE_ENV=production

# Copy the connection string from Supabase Dashboard > Connect.
# Use the Session Pooler URL for hosted/serverless deployments.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=https://your-frontend-domain.example

JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-at-least-32-bytes
SIGNATURE_SECRET=replace-with-at-least-32-bytes
PAYMENT_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

ENABLE_ADMIN_API=true
DEFAULT_COUNTRY_CODE=NP
DEFAULT_CURRENCY_CODE=NPR
DEFAULT_LOCALE=en-NP
DEFAULT_TIMEZONE=Asia/Kathmandu
DEFAULT_TAX_REGIME=IRD
