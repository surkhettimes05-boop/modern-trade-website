# Legacy StoreSync backend retained temporarily for staff/admin/operations routes.
API_URL=https://api.example.com

# Pasalho OS is the source of truth for customer commerce.
# Point this at the NestJS Pasalho backend origin, without /api/v1.
PASALHO_API_URL=https://api.pasalho.com
# Optional server-rendered default store for the pilot. Browser geolocation can
# replace it after /commerce/serviceability/resolve succeeds.
PASALHO_DEFAULT_FULFILLMENT_LOCATION_ID=
PASALHO_DEFAULT_STORE_NAME=Pasalho Birendranagar

API_UPSTREAM_TIMEOUT_MS=8000
IMAGE_CDN_URL=
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_SITE_URL=https://pasalho.com
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
NEXT_PUBLIC_ACTIVE_MARKET=NP

# Legacy local fallback only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
