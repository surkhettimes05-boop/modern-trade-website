# Absolute URL of the deployed Fastify backend. Keep this server-side-only;
# the browser calls the same-origin /api proxy route.
API_URL=https://api.example.com
API_UPSTREAM_TIMEOUT_MS=8000
IMAGE_CDN_URL=
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_SITE_URL=https://storesync.com
# Optional: send anonymous Core Web Vitals to an external analytics collector.
# Defaults to the same-origin /api/web-vitals endpoint and application logs.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
NEXT_PUBLIC_ACTIVE_MARKET=NP

# Optional fallback for local development only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
