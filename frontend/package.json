{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:seo": "playwright test tests/seo.spec.ts --project=chromium-desktop",
    "test:performance": "playwright test tests/performance.spec.ts --project=chromium-desktop --project=chromium-mobile --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
